generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int    @id @default(autoincrement())
  customer_id       Int
  username          String @db.VarChar(255)
  password          String @db.VarChar(255)
  isActive          Int
  passwordRequest   String @db.VarChar(255)
  ispasswordRequest Int

  @@unique([customer_id, username], map: "users_customer_id_username_unique")
  @@map("users")
}

model AppUser {
  id             Int    @id @default(autoincrement())
  customer_id    Int
  username       String @db.VarChar(255)
  machine_number String @db.Char(16)
  created_at     String @db.VarChar(255)

  @@unique([machine_number], name: "unique_machine_number")
  @@unique([customer_id, username], name: "unique_username_per_customer")
  @@index([customer_id], map: "idx_app_user_customer_id")
  @@map("app_user")
}

model Category {
  id          Int         @id @default(autoincrement())
  customer_id Int
  name        String      @db.VarChar(255)
  items       Item[]
  histories   History[]
  inventories Inventory[]

  @@unique([customer_id, name], name: "unique_category_per_customer")
  @@map("category")
}

model Location {
  id          Int         @id @default(autoincrement())
  customer_id Int
  name        String      @db.VarChar(255)
  email       String?     @db.VarChar(255)
  histories   History[]
  inventories Inventory[]

  @@unique([customer_id, name], name: "unique_location_per_customer")
  @@map("location")
}

model Status {
  id          Int         @id @default(autoincrement())
  customer_id Int
  status      String      @db.VarChar(255)
  histories   History[]
  inventories Inventory[]
  packs       Pack[]

  @@unique([customer_id, status], name: "unique_status_per_customer")
  @@map("status")
}

model Item {
  id          Int         @id @default(autoincrement())
  customer_id Int
  category_id Int
  name        String      @db.VarChar(255)
  tag         String      @db.VarChar(255)
  category    Category    @relation(fields: [category_id], references: [id], onDelete: Cascade)
  histories   History[]
  inventories Inventory[]
  packItems   PackItem[]

  @@unique([customer_id, tag], name: "unique_tag_per_customer")
  @@index([category_id], map: "category_id")
  @@map("item")
}

model Inventory {
  id          Int      @id @default(autoincrement())
  customer_id Int
  category_id Int
  item_id     Int
  location_id Int
  status_id   Int
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)
  item        Item     @relation(fields: [item_id], references: [id], onDelete: Cascade)
  location    Location @relation(fields: [location_id], references: [id], onDelete: Cascade)
  status      Status   @relation(fields: [status_id], references: [id], onDelete: Cascade)

  @@index([category_id, item_id, location_id, status_id], map: "customer_id")
  @@map("inventory")
}

model History {
  id          Int      @id @default(autoincrement())
  customer_id Int
  category_id Int
  item_id     Int
  location_id Int
  status_id   Int
  date        String   @db.VarChar(255)
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)
  item        Item     @relation(fields: [item_id], references: [id], onDelete: Cascade)
  location    Location @relation(fields: [location_id], references: [id], onDelete: Cascade)
  status      Status   @relation(fields: [status_id], references: [id], onDelete: Cascade)

  @@index([category_id, item_id, location_id, status_id], map: "customer_id")
  @@map("history")
}

model Pack {
  id          Int        @id @default(autoincrement())
  customer_id Int
  name        String     @db.VarChar(255)
  status_id   Int?
  created_at  String     @db.VarChar(255)
  status      Status?    @relation(fields: [status_id], references: [id], onDelete: SetNull)
  items       PackItem[]

  @@unique([customer_id, name], name: "unique_pack_name_per_customer")
  @@index([customer_id], map: "idx_pack_customer_id")
  @@index([status_id], map: "idx_pack_status_id")
  @@map("pack")
}

model PackItem {
  id          Int    @id @default(autoincrement())
  customer_id Int
  pack_id     Int
  item_id     Int    @unique
  added_at    String @db.VarChar(255)
  pack        Pack   @relation(fields: [pack_id], references: [id], onDelete: Cascade)
  item        Item   @relation(fields: [item_id], references: [id], onDelete: Cascade)

  @@unique([pack_id, item_id], name: "unique_pack_item")
  @@index([customer_id], map: "idx_pack_item_customer_id")
  @@map("pack_item")
}

model ApiKey {
  id          Int    @id @default(autoincrement())
  customer_id Int
  api_key     String @db.VarChar(255)
  created_at  String @db.VarChar(255)

  @@map("apikey")
}
